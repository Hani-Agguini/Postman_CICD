    pipeline {
        agent { docker { image 'postman/newman:latest' } }
    
    
        stages {
            stage( 'Tests API' ) {
                steps { 
                    sh 'npm install -g newman newman-reporter-htmlextra'
                    sh '''newman run Postman_CICD.postman_collection.json \\
                    -e API_EFI.postman_environment.json  \\
                    -r cli,junit,htmlextra \\
                    --reporter-junit- export resultats/newman.xml \\
                    --reporter-htmlextra- export resultats/rapport.html '''
                }
            }
        }
        post {
            always {
                junit 'resultats/newman.xml'
                archiveArtifacts artifacts: 'resultats/rapport.html'
            }
        }
}